{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "tangram",
  "main": "worker/index.ts",
  "compatibility_date": "2026-10-01",
  // player accounts and sync (schema in migrations/, applied by deploy.yml)
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "tangram",
      "database_id": "b946ef09-d9c4-40ce-87c4-5285c8462c22",
      "migrations_dir": "migrations"
    }
  ],
  // per-IP limits: creating players, and every request that presents a sync code
  "ratelimits": [
    { "name": "CREATE_LIMIT", "namespace_id": "1001", "simple": { "limit": 5, "period": 60 } },
    { "name": "API_LIMIT", "namespace_id": "1002", "simple": { "limit": 60, "period": 60 } }
  ],
  // the public site; declared here so CI deploys keep the custom domain attached
  "routes": [{ "pattern": "tangram.apexlearninghub.org", "custom_domain": true }],
  // keep *.workers.dev on: version preview links (wrangler versions upload) live there
  "workers_dev": true,
  "preview_urls": true,
  "assets": {
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"]
  }
}
